generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String                 @id @default(uuid()) @db.Uuid
  username       String                 @unique
  email          String                 @unique
  name           String
  password       String
  position       String?
  image          String?
  isActive       Boolean                @default(true)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  driver         Driver?
  receipts       PurchaseOrderReceipt[]
  purchaseOrders PurchaseOrder[]
  roles          Role[]                 @relation("UserRoles")
  pemesanPOs     PurchaseOrder[]        @relation("POPemesan")
  mengetahuiPOs  PurchaseOrder[]        @relation("POMengetahui")
  approvedPOs    PurchaseOrder[]        @relation("POApprovals")
  rejectedPOs    PurchaseOrder[]        @relation("PORejections")

  @@map("users")
}

model Role {
  id    String @id @default(uuid()) @db.Uuid
  name  String @unique
  users User[] @relation("UserRoles")

  @@map("roles")
}

model Customer {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  company   String?
  email     String?
  phone     String?
  address   String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  leads     Lead[]
  projects  Project[]

  @@map("customers")
}

model Lead {
  id             String     @id @default(uuid()) @db.Uuid
  customerId     String     @db.Uuid
  projectName    String
  description    String?
  status         String     @default("NEW")
  source         String?
  assignedToId   String?
  value          Decimal?   @default(0) @db.Decimal(18, 2)
  projectType    String?    @default("PO_PROJECT")
  leadNumber     String?    @unique
  salesPerson    String?
  expectedDate   DateTime?
  probability    Int?
  globalDriveUrl String?
  estimatedTonnage Float?   @default(0)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  documents      Document[] @relation("LeadDocuments")
  customer       Customer   @relation(fields: [customerId], references: [id])
  project        Project?

  @@map("leads")
}

model Project {
  id               String             @id @default(uuid()) @db.Uuid
  projectNumber    String?            @unique
  projectName      String
  customerId       String             @db.Uuid
  leadId           String?            @unique @db.Uuid
  description      String?
  status           String             @default("PENDING")
  ppicStatus       String             @default("PENDING")
  engStatus        String             @default("PENDING")
  prodStatus       String             @default("PENDING")
  expectedDate     DateTime?
  startDate        DateTime?          @default(now())
  globalDriveUrl   String?
  estimatedTonnage Float?             @default(0)
  value            Decimal?           @default(0) @db.Decimal(18, 2)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  purchasingStatus String             @default("PENDING")
  warehouseStatus  String             @default("PENDING")
  qcStatus         String             @default("PENDING")
  dealAt                DateTime?
  boqApprovedAt         DateTime?
  spbCompletedAt        DateTime?
  poCompletedAt         DateTime?
  productionCompletedAt DateTime?
  qcCompletedAt         DateTime?
  logStatus        String             @default("PENDING")
  packingListUrl   String?
  markingStatus    String             @default("PENDING")
  documents        Document[]         @relation("ProjectDocuments")
  productionLogs   ProductionLog[]
  productionSetup  ProductionSetup?
  productionStages ProductionStage[]
  components       ProjectComponent[]
  handovers        ProjectHandover[]
  history          ProjectHistory[]
  customer         Customer           @relation(fields: [customerId], references: [id])
  lead             Lead?              @relation(fields: [leadId], references: [id])
  qcLogs           QCLog[]
  shipmentPackages ShipmentPackage[]
  shipments        Shipment[]
  spb              SPB[]
  spbGudang        SpbGudang[]
  spj              SPJ[]
  boqs             BoQ[]
  masterplan       Masterplan?
  conveyorUnits    ConveyorUnit[]
  goodsReleaseMemos GoodsReleaseMemo[]
  qcCheckpoints    QCItemCheckpoint[]
  qcRevisions      QCRevision[]

  @@map("projects")
}

model ProjectHistory {
  id         String    @id @default(uuid()) @db.Uuid
  projectId  String    @db.Uuid
  division   String?
  status     String?
  entryDate  DateTime  @default(now())
  exitDate   DateTime?
  notes      String?
  action     String?
  fromStatus String?
  toStatus   String?
  remark     String?
  updatedBy  String?
  createdAt  DateTime  @default(now())
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_histories")
}

model Document {
  id         String   @id @default(uuid()) @db.Uuid
  name       String?
  url        String
  fileType   String?
  category   String?
  version    Int      @default(1)
  label      String?
  fileName   String?
  isExternal Boolean  @default(false)
  uploadedBy String?
  notes      String?
  tonnage    Float?   @default(0)
  leadId     String?  @db.Uuid
  projectId  String?  @db.Uuid
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  lead       Lead?    @relation("LeadDocuments", fields: [leadId], references: [id])
  project    Project? @relation("ProjectDocuments", fields: [projectId], references: [id])

  @@map("documents")
}

model ItemType {
  id         String   @id @default(uuid()) @db.Uuid
  name       String   @unique
  createdAt  DateTime @default(now())
  codePrefix String?  @unique
  items      Item[]

  @@map("item_types")
}

model Unit {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  createdAt DateTime @default(now())
  items     Item[]

  @@map("units")
}

model Item {
  id               String              @id @default(uuid()) @db.Uuid
  code             String              @unique
  name             String?
  typeMerk         String?
  partNumber       String?
  model            String?
  brandId          String?             @db.Uuid
  locationId       String?             @db.Uuid
  specs            Json?
  initialStock     Float               @default(0)
  currentStock     Float               @default(0)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  itemTypeId       String?             @db.Uuid
  unitId           String?             @db.Uuid
  minStock         Float               @default(0)
  description      String?
  imageUrl         String?
  category         String              @default("A")
  reservedStock    Float               @default(0)
  itemCategory     String              @default("CONSUMABLE")
  conditionStatus  String              @default("BAIK")
  goodStock        Float               @default(0)
  damagedStock     Float               @default(0)
  maintenanceStock Float               @default(0)
  unitPrice        Decimal             @default(0) @db.Decimal(18, 2)
  itemType         ItemType?           @relation(fields: [itemTypeId], references: [id])
  unit             Unit?               @relation(fields: [unitId], references: [id])
  brand            Brand?              @relation(fields: [brandId], references: [id])
  location         StorageLocation?    @relation(fields: [locationId], references: [id])
  locationStocks   ItemLocationStock[]
  poItems          PurchaseOrderItem[]
  shipmentPackages ShipmentPackage[]
  spbItems         SPBItem[]
  opnameDetails    StockOpnameDetail[]
  transactions     Transaction[]
  boqItems         BoQItem[]
  goodsMemoItems   GoodsReleaseMemoItem[]
  spbGudangItems   SpbGudangItem[]

  @@map("items")
}

model Brand {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  items     Item[]

  @@map("brands")
}

model StorageLocation {
  id           String              @id @default(uuid()) @db.Uuid
  name         String              @unique
  code         String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  items        Item[]
  stocks       ItemLocationStock[]
  transactions Transaction[]

  @@map("storage_locations")
}

model SpecAttribute {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  unit      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("spec_attributes")
}

model ItemUsageType {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  code      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("item_usage_types")
}

model ItemLocationStock {
  id          String          @id @default(uuid()) @db.Uuid
  itemId      String          @db.Uuid
  locationId  String          @db.Uuid
  qty         Float           @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  item        Item            @relation(fields: [itemId], references: [id], onDelete: Cascade)
  location    StorageLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([itemId, locationId])
  @@map("item_location_stocks")
}

model Transaction {
  id         String           @id @default(uuid()) @db.Uuid
  date       DateTime         @default(now())
  type       String
  itemId     String           @db.Uuid
  locationId String?          @db.Uuid
  quantity   Float
  createdAt  DateTime         @default(now())
  note       String?
  peruntukan String?
  poNumber   String?
  supplier   String?
  item       Item             @relation(fields: [itemId], references: [id], onDelete: Cascade)
  location   StorageLocation? @relation(fields: [locationId], references: [id])

  @@map("transactions")
}

model StockOpname {
  id      String              @id @default(uuid()) @db.Uuid
  date    DateTime            @default(now())
  month   Int
  year    Int
  notes   String?
  status  String              @default("OPEN")
  details StockOpnameDetail[]

  @@map("stock_opnames")
}

model StockOpnameDetail {
  id            String      @id @default(uuid()) @db.Uuid
  stockOpnameId String      @db.Uuid
  itemId        String      @db.Uuid
  systemStock   Float
  physicalStock Float
  difference    Float
  item          Item        @relation(fields: [itemId], references: [id])
  stockOpname   StockOpname @relation(fields: [stockOpnameId], references: [id], onDelete: Cascade)

  @@map("stock_opname_details")
}

model PurchaseOrder {
  id                 String                 @id @default(uuid()) @db.Uuid
  nomorPO            String                 @unique
  kepada             String
  tanggal            DateTime
  periode            String?
  p_np               String?
  projek             String?
  status             String                 @default("PENDING")
  totalAmount        Decimal                @default(0) @db.Decimal(18, 2)
  paidAmount         Decimal                @default(0) @db.Decimal(18, 2)
  paymentStatus      String                 @default("UNPAID")
  isReceived         Boolean                @default(false)
  receivedAt         DateTime?
  suratJalanUrl      String?
  qcStatus           String                 @default("NONE")
  qcRequestedAt      DateTime?
  qcApprovedAt       DateTime?
  qcApprovedBy       String?
  qcNotes            String?
  signatureUrl       String?
  keteranganTambahan String?
  hormatKami         String?
  userId             String                 @db.Uuid
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  poType             String?                @default("MANUAL")
  taxType            String?                @default("NON_PAJAK")
  npwp               String?
  att                String?
  telpFax            String?
  terbilang          String?
  pphEnabled         Boolean                @default(false)
  discountPercent    Float?                 @default(0)
  discountAmount     Decimal?               @default(0) @db.Decimal(18, 2)
  ppnAmount          Decimal?               @default(0) @db.Decimal(18, 2)
  pphAmount          Decimal?               @default(0) @db.Decimal(18, 2)
  nettoAmount        Decimal?               @default(0) @db.Decimal(18, 2)
  showPemesan        Boolean                @default(true)
  showMengetahui     Boolean                @default(true)
  showMenyetujui     Boolean                @default(true)
  showPhotosInPrint  Boolean                @default(true)
  namaPemesan        String?
  namaMengetahui     String?
  namaMenyetujui     String?
  sampleImageUrl     String?
  paymentMethod      String?                @default("CASH")
  installmentTerm    String?
  dueDate            DateTime?
  isUrgent           Boolean                @default(false)
  priority           String                 @default("NORMAL")
  priorityNotes      String?
  bankName           String?
  bankAccountNo      String?
  bankAccountName    String?
  fakturPajakNo      String?
  fakturPajakUrl     String?
  supplierId         String?                @db.Uuid
  items              PurchaseOrderItem[]
  payments           PurchaseOrderPayment[]
  receipts           PurchaseOrderReceipt[]
  supplier           Supplier?              @relation(fields: [supplierId], references: [id])
  user               User                   @relation(fields: [userId], references: [id])
  pemesanId          String?                @db.Uuid
  pemesanUser        User?                  @relation("POPemesan", fields: [pemesanId], references: [id])
  pemesanAt          DateTime?
  mengetahuiId       String?                @db.Uuid
  mengetahuiUser     User?                  @relation("POMengetahui", fields: [mengetahuiId], references: [id])
  mengetahuiAt       DateTime?
  approvedById       String?                @db.Uuid
  approvedBy         User?                  @relation("POApprovals", fields: [approvedById], references: [id])
  approvedAt         DateTime?
  rejectedReason     String?
  rejectedAt         DateTime?
  rejectedById       String?                @db.Uuid
  rejectedUser       User?                  @relation("PORejections", fields: [rejectedById], references: [id])

  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String                     @id @default(uuid()) @db.Uuid
  purchaseOrderId String                     @db.Uuid
  namaBarang      String
  kode            String?
  ukuran          String?
  qty             Float
  satuan          String
  hargaSatuan     Decimal                    @default(0) @db.Decimal(18, 2)
  disc            Float?
  ppn             Float?
  pph             Float?
  subTotal        Decimal                    @db.Decimal(18, 2)
  noticeMerkJenis String?
  noSpb           String?
  lokasi          String?
  tglDatang       DateTime?
  tglKirim        DateTime?
  tglSampai       DateTime?
  isClosed        Boolean                    @default(false)
  itemId          String?                    @db.Uuid
  imageUrl        String?
  qtyReceived     Float                      @default(0)

  // 🔴 Field Inspeksi QC Per-Item
  qcStatus        String                     @default("NONE") // NONE, PENDING_INSPECTION, PASSED, FAILED
  qtyPassed       Float                      @default(0)
  qtyFailed       Float                      @default(0)
  qcDefectReason  String?
  qcApprovedAt    DateTime?
  qcApprovedBy    String?
  qcNotes         String?
  qcAttachments   String[]                   @default([])

  item            Item?                      @relation(fields: [itemId], references: [id])
  purchaseOrder   PurchaseOrder              @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  receiptItems    PurchaseOrderReceiptItem[]

  @@map("purchase_order_items")
}

model PurchaseOrderPayment {
  id              String        @id @default(uuid()) @db.Uuid
  purchaseOrderId String        @db.Uuid
  amount          Float
  paymentDate     DateTime      @default(now())
  method          String
  notes           String?
  proofUrl        String?
  createdAt       DateTime      @default(now())
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@map("purchase_order_payments")
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  title     String
  message   String
  type      String   @default("INFO")
  targetUrl String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  module    String   @default("TRACKER")

  @@map("notifications")
}

model SPB {
  id                  String    @id @default(uuid()) @db.Uuid
  spbNumber           String    @unique
  projectId           String    @db.Uuid
  spbType             String    @default("PROYEK")
  date                DateTime  @default(now())
  status              String    @default("PENDING_APPROVAL")
  makerName           String?
  mengetahuiName      String?   @default("Slamet")
  menyetujuiName      String?
  approvedByPpic      Boolean   @default(false)
  approvedByPpicAt    DateTime?
  approvedByPm        Boolean   @default(false)
  approvedByPmAt      DateTime?
  approvedByDireksi   Boolean   @default(false)
  approvedByDireksiAt DateTime?
  rejectedReason      String?
  rejectedAt          DateTime?
  deadlineDate        DateTime?
  imageUrl            String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  project             Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  items               SPBItem[]

  @@map("spb")
}

model SpbGudang {
  id                  String          @id @default(uuid()) @db.Uuid
  spbNumber           String          @unique
  projectId           String?         @db.Uuid
  date                DateTime        @default(now())
  status              String          @default("PENDING_PPIC")
  makerName           String?
  approvedByPpic      Boolean         @default(false)
  approvedByPpicAt    DateTime?
  approvedByDireksi   Boolean         @default(false)
  approvedByDireksiAt DateTime?
  rejectedReason      String?
  rejectedAt          DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  project             Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  items               SpbGudangItem[]

  @@map("spb_gudang")
}

model SpbGudangItem {
  id                    String    @id @default(uuid()) @db.Uuid
  spbGudangId           String    @db.Uuid
  materialId            String?   @db.Uuid
  name                  String
  typeMerk              String?
  qty                   Float
  unit                  String    @default("pcs")
  source                String    @default("WAREHOUSE")
  note                  String?
  status                String    @default("PENDING")
  approvalPpic          String    @default("PENDING")
  approvalPm            String    @default("NONE")
  approvalDireksi       String    @default("NONE")
  selectedSupplierId    String?   @db.Uuid
  selectedSupplierName  String?
  selectedCatalogPrice  Decimal?  @db.Decimal(18, 2)
  candidateSuppliers    Json?
  vendorSelectionStatus String    @default("NONE")
  vendorSelectionNote   String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  spbGudang             SpbGudang @relation(fields: [spbGudangId], references: [id], onDelete: Cascade)
  item                  Item?     @relation(fields: [materialId], references: [id], onDelete: SetNull)

  @@map("spb_gudang_items")
}

model SPBItem {
  id         String   @id @default(uuid()) @db.Uuid
  spbId      String   @db.Uuid
  materialId String?  @db.Uuid
  name       String
  qty        Float
  unit       String   @default("pcs")
  source     String
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  typeMerk   String?
  status     String   @default("PENDING")
  qtyIssued  Float    @default(0)
  hasSubstitution        Boolean   @default(false)
  originalName           String?
  originalTypeMerk       String?
  originalMaterialId     String?   @db.Uuid
  originalPrice          Decimal?  @db.Decimal(18, 2)
  substitutedName        String?
  substitutedTypeMerk    String?
  substitutedMaterialId  String?   @db.Uuid
  substitutedPrice       Decimal?  @db.Decimal(18, 2)
  substitutedSupplierId  String?   @db.Uuid
  substitutedSupplierName String?
  selectedSupplierId     String?   @db.Uuid
  selectedSupplierName   String?
  selectedCatalogPrice   Decimal?  @db.Decimal(18, 2)
  candidateSuppliers     Json?
  vendorSelectionStatus   String    @default("NONE")
  vendorSelectionNote     String?
  substitutionReason     String?
  approvalEngineering    String    @default("NONE")
  approvalPpic           String    @default("NONE")
  approvalPm             String    @default("NONE")
  approvalDireksi        String    @default("NONE")
  substitutionStatus     String    @default("NONE")
  material   Item?    @relation(fields: [materialId], references: [id])
  spb        SPB      @relation(fields: [spbId], references: [id], onDelete: Cascade)
  memoItems  GoodsReleaseMemoItem[]

  @@map("spb_items")
}

// ============================================================
// SURAT PERMINTAAN JASA (SPJ)
// ============================================================

model SPJ {
  id               String    @id @default(uuid()) @db.Uuid
  spjNumber        String    @unique
  projectId        String    @db.Uuid
  date             DateTime  @default(now())
  status           String    @default("PENDING_APPROVAL")
  makerName        String?
  mengetahuiName   String?   @default("Slamet")
  menyetujuiName   String?
  approvedByPpic   Boolean   @default(false)
  approvedByPpicAt DateTime?
  approvedByPm     Boolean   @default(false)
  approvedByPmAt   DateTime?
  rejectedReason   String?
  rejectedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  project          Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  items            SPJItem[]

  @@map("spj")
}

model SPJItem {
  id        String   @id @default(uuid()) @db.Uuid
  spjId     String   @db.Uuid
  name      String
  qty       Float    @default(1)
  unit      String   @default("ls")
  note      String?
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  spj       SPJ      @relation(fields: [spjId], references: [id], onDelete: Cascade)

  @@map("spj_items")
}

model Supplier {
  id             String          @id @default(uuid()) @db.Uuid
  name           String          @unique
  codeLetter     String
  codeNumber     String
  phone          String?
  address        String?
  isActive       Boolean         @default(true)
  p_np           String          @default("JLUNP")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  mapsUrl        String?
  shopName       String?
  soldItems      String?
  purchaseOrders PurchaseOrder[]

  @@map("suppliers")
}

model Driver {
  id            String     @id @default(uuid()) @db.Uuid
  name          String
  phone         String?
  licenseNumber String?
  status        String     @default("AVAILABLE")
  userId        String?    @unique @db.Uuid
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  user          User?      @relation(fields: [userId], references: [id])
  shipments     Shipment[]

  @@map("drivers")
}

model Vehicle {
  id          String     @id @default(uuid()) @db.Uuid
  name        String
  plateNumber String     @unique
  type        String
  status      String     @default("AVAILABLE")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  shipments   Shipment[]

  @@map("vehicles")
}

model Shipment {
  id                 String            @id @default(uuid()) @db.Uuid
  suratJalanNo       String?           @unique
  projectId          String            @db.Uuid
  deliveryDate       DateTime
  shippingMethod     String
  destination        String
  estimatedWeight    Float?
  estimatedDimension String?
  notes              String?
  status             String            @default("READY_TO_SHIP")
  fleetRequestStatus String?
  driverId           String?           @db.Uuid
  vehicleId          String?           @db.Uuid
  approvalLogistics  Boolean           @default(false)
  approvalPurchasing Boolean           @default(false)
  approvalManagement Boolean           @default(false)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  packages           ShipmentPackage[]
  driver             Driver?           @relation(fields: [driverId], references: [id])
  project            Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  vehicle            Vehicle?          @relation(fields: [vehicleId], references: [id])

  @@map("shipments")
}

model ShipmentPackage {
  id                 String             @id @default(uuid()) @db.Uuid
  code               String             @unique
  lotNo              String
  projectId          String             @db.Uuid
  itemId             String?            @db.Uuid
  itemName           String
  itemCode           String?
  qty                Float
  unit               String
  weight             Float
  dimensions         String
  status             String             @default("READY_TO_SHIP")
  shipmentId         String?            @db.Uuid
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  qcStatus           String             @default("PENDING")
  project_components ProjectComponent[]
  item               Item?              @relation(fields: [itemId], references: [id])
  project            Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  shipment           Shipment?          @relation(fields: [shipmentId], references: [id])

  @@map("shipment_packages")
}

model PurchaseOrderReceipt {
  id                   String                     @id @default(uuid()) @db.Uuid
  purchaseOrderId      String                     @db.Uuid
  noSuratJalanSupplier String
  suratJalanUrl        String
  receivedAt           DateTime
  receivedById         String                     @db.Uuid
  notes                String?
  createdAt            DateTime                   @default(now())

  qcStatus             String                     @default("PENDING")
  qcExternalId         String?
  qcApprovedAt         DateTime?
  qcApprovedBy         String?
  qcNotes              String?
  qcReportUrl          String?

  items                PurchaseOrderReceiptItem[]
  purchaseOrder        PurchaseOrder              @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  user                 User                       @relation(fields: [receivedById], references: [id])

  @@map("purchase_order_receipts")
}

model PurchaseOrderReceiptItem {
  id                  String               @id @default(uuid()) @db.Uuid
  receiptId           String               @db.Uuid
  purchaseOrderItemId String               @db.Uuid
  qtyReceived         Float

  qcStatus            String               @default("PENDING")
  qtyPassed           Float                @default(0)
  qtyFailed           Float                @default(0)
  qcDefectReason      String?

  purchaseOrderItem   PurchaseOrderItem    @relation(fields: [purchaseOrderItemId], references: [id], onDelete: Cascade)
  receipt             PurchaseOrderReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@map("purchase_order_receipt_items")
}

model ProductionSetup {
  id              String   @id @default(uuid()) @db.Uuid
  projectId       String   @unique @db.Uuid
  drawingApproved Boolean  @default(false)
  drawingLink     String?
  materialsReady  Boolean  @default(false)
  materialsNotes  String?
  instructionMemo String
  leader          String
  team            String
  startedAt       DateTime @default(now())
  startedBy       String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("production_setups")
}

model ProductionStage {
  id             String              @id @default(uuid()) @db.Uuid
  name           String
  progress       Int                 @default(0)
  status         String              @default("READY")
  notes          String?
  assignedLeader String?
  assignedTeam   String?
  updatedAt      DateTime            @updatedAt
  createdAt      DateTime            @default(now())
  qcNotes        String?
  qcStatus       String              @default("PENDING")
  projectId      String              @db.Uuid
  project        Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  subSteps       ProductionSubStep[]
  qcLogs         QCLog[]

  @@map("production_stages")
}

model ProductionSubStep {
  id        String          @id @default(uuid()) @db.Uuid
  stageId   String          @db.Uuid
  name      String
  checked   Boolean         @default(false)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  qcNotes   String?
  qcStatus  String          @default("PENDING")
  stage     ProductionStage @relation(fields: [stageId], references: [id], onDelete: Cascade)

  @@map("production_sub_steps")
}

model ProductionLog {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @db.Uuid
  message   String
  user      String
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("production_logs")
}

model QCLog {
  id        String          @id @default(uuid()) @db.Uuid
  projectId String          @db.Uuid
  stageId   String          @db.Uuid
  status    String
  notes     String?
  user      String
  createdAt DateTime        @default(now())
  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stage     ProductionStage @relation(fields: [stageId], references: [id], onDelete: Cascade)

  @@map("qc_logs")
}

model ProjectHandover {
  id         String             @id @default(uuid()) @db.Uuid
  projectId  String             @db.Uuid
  stages     String
  notes      String?
  handoverBy String
  createdAt  DateTime           @default(now())
  components ProjectComponent[]
  project    Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_handovers")
}

model ProjectComponent {
  id                String           @id @default(uuid()) @db.Uuid
  projectId         String           @db.Uuid
  name              String
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  handoverId        String?          @db.Uuid
  markingStatus     String           @default("PENDING")
  packageId         String?          @db.Uuid
  logAccepted       Boolean          @default(false)
  stages            ComponentStage[]
  handover          ProjectHandover? @relation(fields: [handoverId], references: [id])
  shipment_packages ShipmentPackage? @relation(fields: [packageId], references: [id])
  project           Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_components")
}

model ComponentStage {
  id             String           @id @default(uuid()) @db.Uuid
  componentId    String           @db.Uuid
  name           String
  status         String           @default("READY")
  progress       Int              @default(0)
  notes          String?
  qcStatus       String           @default("PENDING")
  qcNotes        String?
  updatedAt      DateTime         @updatedAt
  createdAt      DateTime         @default(now())
  assignedLeader String?
  assignedTeam   String?
  component      ProjectComponent @relation(fields: [componentId], references: [id], onDelete: Cascade)

  @@map("component_stages")
}

model BoQ {
  id                  String             @id @default(uuid()) @db.Uuid
  projectId           String             @db.Uuid
  project             Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  boqNumber           String             @unique
  boqStatus           String             @default("DRAFT")
  boqApprovedByPpic   Boolean            @default(false)
  boqApprovedByPpicAt DateTime?
  boqApprovedByPm     Boolean            @default(false)
  boqApprovedByPmAt   DateTime?
  boqMakerName        String?
  boqRejectedReason   String?
  boqRejectedAt       DateTime?
  totalTonnage        Float?             @default(0)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  boqItems            BoQItem[]

  @@map("boqs")
}

model BoQItem {
  id          String   @id @default(uuid()) @db.Uuid
  boqId       String   @db.Uuid
  boq         BoQ      @relation(fields: [boqId], references: [id], onDelete: Cascade)
  
  itemId      String   @db.Uuid
  item        Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  
  qty         Float
  unit        String   @default("pcs")
  price       Decimal  @default(0) @db.Decimal(18, 2)
  weightTon   Float?   @default(0)
  note        String?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("boq_items")
}

// ============================================================
// MASTERPLAN — Konfigurasi Bobot & Jadwal Proyek
// ============================================================

model Masterplan {
  id              String            @id @default(uuid()) @db.Uuid
  projectId       String            @unique @db.Uuid
  project         Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  totalWeeks      Int               @default(30)
  startDate       DateTime
  createdBy       String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  
  phases          MasterplanPhase[]
  weeklyPlans     WeeklyPlan[]
  divisionLeaders DivisionLeader[]

  @@map("masterplans")
}

model DivisionLeader {
  id            String     @id @default(uuid()) @db.Uuid
  masterplanId  String     @db.Uuid
  masterplan    Masterplan @relation(fields: [masterplanId], references: [id], onDelete: Cascade)
  
  divisionName  String     // "PROCUREMENT" | "ENGINEERING" | "FABRICATION" | "CIVIL" | "LOGISTICS" | "SHIPMENT" | "ERECTION" | "COMMISSIONING"
  leaderName    String
  leaderUserId  String?    @db.Uuid
  assignedAt    DateTime   @default(now())

  @@unique([masterplanId, divisionName])
  @@map("division_leaders")
}

// ============================================================
// MASTERPLAN PHASES (Dinamis & Dapat Dikustomisasi)
// ============================================================

model MasterplanPhase {
  id              String          @id @default(uuid()) @db.Uuid
  masterplanId    String          @db.Uuid
  masterplan      Masterplan      @relation(fields: [masterplanId], references: [id], onDelete: Cascade)
  
  name            String          // "Procurement", "Engineering", dll.
  code            String          // Kode unik per proyek (misal: "PROCUREMENT")
  orderIndex      Int
  weightPercent   Decimal         @db.Decimal(5, 2)
  startWeek       Int             // Minggu mulai (1 s/d totalWeeks)
  endWeek         Int             // Minggu akhir
  
  planProgress    Decimal         @default(0) @db.Decimal(5, 2)
  actualProgress  Decimal         @default(0) @db.Decimal(5, 2)
  status          String          @default("NOT_STARTED") // NOT_STARTED, IN_PROGRESS, COMPLETED
  
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  
  unitProgresses  UnitProgress[]
  subProgresses   PhaseSubStep[]  // Untuk breakdown sub-langkah dinamis (Shipment, Erection, dll.)
  weeklyTargets   PhaseWeeklyTarget[] // Custom target mingguan per phase

  @@unique([masterplanId, code])
  @@map("masterplan_phases")
}

model PhaseWeeklyTarget {
  id            String          @id @default(uuid()) @db.Uuid
  phaseId       String          @db.Uuid
  phase         MasterplanPhase @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  weekNumber    Int
  targetPercent Decimal         @db.Decimal(5, 2)

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@unique([phaseId, weekNumber])
  @@map("phase_weekly_targets")
}

model PhaseSubStep {
  id              String          @id @default(uuid()) @db.Uuid
  phaseId         String          @db.Uuid
  phase           MasterplanPhase @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  
  name            String          // "Dry Run Test (no load)", dll.
  weightPercent   Decimal         @db.Decimal(5, 2) // Bobot internal sub-step (total sub-step = 100%)
  checked         Boolean         @default(false)
  checkedAt       DateTime?
  checkedBy       String?
  
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@map("phase_sub_steps")
}

// ============================================================
// CONVEYOR UNITS & ITEMS
// ============================================================

model ConveyorUnit {
  id            String          @id @default(uuid()) @db.Uuid
  projectId     String          @db.Uuid
  project       Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  name          String          // "Room Hopper 5x5x2.7 mtr"
  unitType      String          // "STRUCTURE" | "MECHANICAL" | "BOTH"
  satuan        String          @default("unit")
  volume        Int             @default(1)
  orderIndex    Int             @default(0)
  
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  
  progresses    UnitProgress[]
  structureItems StructureItem[]
  mechanicalItems MechanicalItem[]
  qcCheckpoints QCItemCheckpoint[]
  qcRevisions   QCRevision[]

  @@unique([projectId, name])
  @@map("conveyor_units")
}

model UnitProgress {
  id            String           @id @default(uuid()) @db.Uuid
  phaseId       String           @db.Uuid
  phase         MasterplanPhase  @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  unitId        String           @db.Uuid
  unit          ConveyorUnit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  
  weightPercent Decimal          @db.Decimal(5, 2) // Bobot unit ini dalam fase
  actualPercent Decimal          @default(0) @db.Decimal(5, 2)
  
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([phaseId, unitId])
  @@map("unit_progresses")
}

model StructureItem {
  id              String        @id @default(uuid()) @db.Uuid
  unitId          String        @db.Uuid
  unit            ConveyorUnit  @relation(fields: [unitId], references: [id], onDelete: Cascade)
  
  name            String
  qty             Int           @default(1)
  satuan          String        @default("set")
  orderIndex      Int           @default(0)
  
  cuttingQty      Int           @default(0)  // 15%
  settingQty      Int           @default(0)  // 35%
  weldingQty      Int           @default(0)  // 40%
  finishingQty    Int           @default(0)  // 5%
  paintingQty     Int           @default(0)  // 3.5%
  packagingQty    Int           @default(0)  // 1.5%

  cuttingDone     Boolean       @default(false)  // 15%
  settingDone     Boolean       @default(false)  // 35%
  weldingDone     Boolean       @default(false)  // 40%
  finishingDone   Boolean       @default(false)  // 5%
  paintingDone    Boolean       @default(false)  // 3.5%
  packagingDone   Boolean       @default(false)  // 1.5%
  
  progressPercent Decimal       @default(0) @db.Decimal(5, 2)
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@map("structure_items")
}

model MechanicalItem {
  id              String        @id @default(uuid()) @db.Uuid
  unitId          String        @db.Uuid
  unit            ConveyorUnit  @relation(fields: [unitId], references: [id], onDelete: Cascade)
  
  name            String
  qty             Int           @default(1)
  satuan          String        @default("unit")
  orderIndex      Int           @default(0)
  
  procurementQty  Int           @default(0) // 40%
  poQty           Int           @default(0) // 10%
  fabricationQty  Int           @default(0) // 45%
  packagingQty    Int           @default(0) // 5%

  procurementDone Boolean       @default(false) // 40%
  poDone          Boolean       @default(false) // 10%
  fabricationDone Boolean       @default(false) // 45%
  packagingDone   Boolean       @default(false) // 5%
  
  progressPercent Decimal       @default(0) @db.Decimal(5, 2)
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@map("mechanical_items")
}

// ============================================================
// WEEKLY PLANS (S-CURVE DATA)
// ============================================================

model WeeklyPlan {
  id                    String     @id @default(uuid()) @db.Uuid
  masterplanId          String     @db.Uuid
  masterplan            Masterplan @relation(fields: [masterplanId], references: [id], onDelete: Cascade)
  
  weekNumber            Int        // 1 s/d totalWeeks
  weekStartDate         DateTime
  weekEndDate           DateTime
  
  planCumulativePercent Decimal    @default(0) @db.Decimal(5, 2)
  planWeeklyPercent     Decimal    @default(0) @db.Decimal(5, 2)
  
  actualCumulativePercent Decimal  @default(0) @db.Decimal(5, 2)
  actualWeeklyPercent     Decimal  @default(0) @db.Decimal(5, 2)
  
  variance              Decimal    @default(0) @db.Decimal(5, 2)
  
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  @@unique([masterplanId, weekNumber])
  @@map("weekly_plans")
}

// ============================================================
// MEMO PENGELUARAN BARANG & PENGEMBALIAN (GOODS ISSUE & RETURN)
// ============================================================

model GoodsReleaseMemo {
  id                  String                  @id @default(uuid()) @db.Uuid
  memoNumber          String                  @unique
  projectId           String?                 @db.Uuid
  project             Project?                @relation(fields: [projectId], references: [id])
  requesterName       String
  division            String                  @default("PRODUKSI")
  notes               String?
  status              String                  @default("PENDING") // PENDING, APPROVED, REJECTED, PARTIALLY_RETURNED, COMPLETED
  rejectedReason      String?
  approvedBy          String?
  approvedAt          DateTime?
  rejectedAt          DateTime?
  syncInventoryStatus String                  @default("PENDING")   // PENDING, SENT_TO_INVENTORY, SYNC_FAILED
  externalSyncAt      DateTime?
  warehouseStatus     String?                 @default("PENDING")  
  warehouseIssuedBy   String?
  warehouseIssuedAt   DateTime?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  items               GoodsReleaseMemoItem[]
  returns             GoodsReturnRecord[]

  @@map("goods_release_memos")
}

model GoodsReleaseMemoItem {
  id            String                  @id @default(uuid()) @db.Uuid
  memoId        String                  @db.Uuid
  memo          GoodsReleaseMemo        @relation(fields: [memoId], references: [id], onDelete: Cascade)
  itemId        String?                 @db.Uuid
  item          Item?                   @relation(fields: [itemId], references: [id])
  spbItemId     String?                 @db.Uuid
  spbItem       SPBItem?                @relation(fields: [spbItemId], references: [id], onDelete: SetNull)
  itemCode      String?
  itemName      String
  itemType      String                  @default("CONSUMABLE") // CONSUMABLE (Sekali Pakai), NON_CONSUMABLE (Alat / Equipment)
  qtyRequested  Float                   @default(1)
  qtyIssued     Float                   @default(0)
  qtyReturned   Float                   @default(0)
  unit          String                  @default("PCS")
  notes         String?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  returnDetails GoodsReturnDetailItem[]

  @@map("goods_release_memo_items")
}

model GoodsReturnRecord {
  id                  String                  @id @default(uuid()) @db.Uuid
  memoId              String                  @db.Uuid
  memo                GoodsReleaseMemo        @relation(fields: [memoId], references: [id], onDelete: Cascade)
  returnNumber        String                  @unique
  returnedBy          String
  returnDate          DateTime                @default(now())
  notes               String?
  syncInventoryStatus String                  @default("PENDING") // PENDING, SENT_TO_INVENTORY, ACC_BY_WAREHOUSE, REJECTED_BY_WAREHOUSE
  warehouseStatus     String                  @default("PENDING_ACC") // PENDING_ACC, APPROVED, REJECTED
  warehouseApprovedBy String?
  warehouseApprovedAt DateTime?
  warehouseNotes      String?
  createdAt           DateTime                @default(now())
  items               GoodsReturnDetailItem[]

  @@map("goods_return_records")
}

model GoodsReturnDetailItem {
  id             String               @id @default(uuid()) @db.Uuid
  returnRecordId String               @db.Uuid
  returnRecord   GoodsReturnRecord    @relation(fields: [returnRecordId], references: [id], onDelete: Cascade)
  memoItemId     String               @db.Uuid
  memoItem       GoodsReleaseMemoItem @relation(fields: [memoItemId], references: [id], onDelete: Cascade)
  qtyReturned    Float
  condition      String               @default("SURPLUS") // SURPLUS (Sisa Pakai), RETURNED_TOOL (Selesai Alat), DAMAGED (Rusak)
  notes          String?

  @@map("goods_return_detail_items")
}

// ============================================================
// QUALITY CONTROL CHECKPOINTS & NCR (REVISION) SYSTEM
// ============================================================

model QCItemCheckpoint {
  id              String            @id @default(uuid()) @db.Uuid
  projectId       String            @db.Uuid
  project         Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  unitId          String            @db.Uuid
  unit            ConveyorUnit      @relation(fields: [unitId], references: [id], onDelete: Cascade)
  
  itemType        String            // "STRUCTURE" | "MECHANICAL"
  itemId          String            @db.Uuid
  stage           String            // "CUTTING", "SETTING", "WELDING", "FINISHING", "PAINTING", "PACKAGING", "FABRICATION"
  
  status          String            @default("PENDING") // PENDING, PASS, FAIL, ON_HOLD
  inspectedBy     String?
  inspectedAt     DateTime?
  notes           String?

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  
  revisions       QCRevision[]

  @@unique([unitId, itemType, itemId, stage])
  @@map("qc_item_checkpoints")
}

model QCRevision {
  id               String            @id @default(uuid()) @db.Uuid
  projectId        String            @db.Uuid
  project          Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  unitId           String?           @db.Uuid
  unit             ConveyorUnit?     @relation(fields: [unitId], references: [id], onDelete: SetNull)
  checkpointId     String?           @db.Uuid
  checkpoint       QCItemCheckpoint? @relation(fields: [checkpointId], references: [id], onDelete: SetNull)
  
  revisionType     String            @default("NCR") // "NCR" | "DRAWING_REVISION"
  level            String            @default("ITEM") // "ITEM" | "UNIT"
  
  ncrNumber        String?           @unique
  ncrCategory      String?           // "DIMENSI", "WELD_QUALITY", "MATERIAL", "ASSEMBLY", "PAINTING", "OTHER"
  ncrDescription   String?
  correctiveAction String?
  resetStage       String?

  drNumber         String?           @unique
  drawingRef       String?
  fieldCondition   String?
  requestedChange  String?
  revisedDocUrl    String?

  status           String            @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED, CLOSED
  raisedBy         String
  raisedAt         DateTime          @default(now())
  
  resolvedBy       String?
  resolvedAt       DateTime?
  resolvedNotes    String?
  
  closedBy         String?
  closedAt         DateTime?
  
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@map("qc_revisions")
}
